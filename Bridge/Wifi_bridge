#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from sensor_msgs.msg import Joy
import socket

ESP32_IP = '192.168.4.1'   # default IP when ESP32 runs as its own Access Point
ESP32_PORT = 4210

MAX_LINEAR = 0.5    # must match scale_linear.x in ps4_config.yaml
MAX_ANGULAR = 1.0   # must match scale_angular.yaw in ps4_config.yaml
MAX_PWM = 255

# Index into the Joy message's "buttons" array. Check your ps4_config.yaml /
# `ros2 topic echo /joy` to confirm this is really the physical button you want.
MODE_TOGGLE_BUTTON_INDEX = 2


class WifiBridge(Node):
    def __init__(self):
        super().__init__('wifi_bridge')

        self.declare_parameter('esp32_ip', ESP32_IP)
        self.declare_parameter('esp32_port', ESP32_PORT)

        self.esp32_ip = self.get_parameter('esp32_ip').get_parameter_value().string_value
        self.esp32_port = self.get_parameter('esp32_port').get_parameter_value().integer_value

        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

        self.last_left = None
        self.last_right = None
        self.last_button_state = 0  # tracks button 2's previous state for edge detection

        self.get_logger().info(f'Sending UDP commands to {self.esp32_ip}:{self.esp32_port}')

        self.subscription = self.create_subscription(
            Twist,
            '/cmd_vel',
            self.cmd_vel_callback,
            10
        )

        self.joy_subscription = self.create_subscription(
            Joy,
            '/joy',
            self.joy_callback,
            10
        )

    def cmd_vel_callback(self, msg: Twist):
        linear = msg.linear.x
        angular = msg.angular.z

        left_pwm, right_pwm = self.twist_to_wheel_speeds(linear, angular)

        if left_pwm != self.last_left or right_pwm != self.last_right:
            self.send_command(left_pwm, right_pwm)
            self.last_left = left_pwm
            self.last_right = right_pwm

    def joy_callback(self, msg: Joy):
        if len(msg.buttons) <= MODE_TOGGLE_BUTTON_INDEX:
            return

        current_state = msg.buttons[MODE_TOGGLE_BUTTON_INDEX]

        # Fire only on the press itself (0 -> 1), not on release or while held,
        # so a single press sends exactly one toggle instead of flooding it
        # every cycle the button stays down.
        if current_state == 1 and self.last_button_state == 0:
            self.send_mode_toggle()

        self.last_button_state = current_state

    def twist_to_wheel_speeds(self, linear, angular):
        norm_linear = clamp(linear / MAX_LINEAR, -1.0, 1.0)
        norm_angular = clamp(angular / MAX_ANGULAR, -1.0, 1.0)

        left = clamp(norm_linear - norm_angular, -1.0, 1.0)
        right = clamp(norm_linear + norm_angular, -1.0, 1.0)

        left_pwm = int(left * MAX_PWM)
        right_pwm = int(right * MAX_PWM)

        return left_pwm, right_pwm

    def send_command(self, left_pwm, right_pwm):
        message = f'{left_pwm},{right_pwm}'
        try:
            self.sock.sendto(message.encode('utf-8'), (self.esp32_ip, self.esp32_port))
            self.get_logger().info(f'Sent: L={left_pwm} R={right_pwm}')
        except OSError as e:
            self.get_logger().error(f'Failed to send UDP packet: {e}')

    def send_mode_toggle(self):
        try:
            self.sock.sendto(b'MODE:TOGGLE', (self.esp32_ip, self.esp32_port))
            self.get_logger().info('Sent: MODE:TOGGLE')
        except OSError as e:
            self.get_logger().error(f'Failed to send MODE:TOGGLE: {e}')

    def destroy_node(self):
        try:
            self.send_command(0, 0)
        except Exception:
            pass
        self.sock.close()
        super().destroy_node()


def clamp(value, min_value, max_value):
    return max(min(value, max_value), min_value)


def main(args=None):
    rclpy.init(args=args)
    node = WifiBridge()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
